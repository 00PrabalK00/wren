[Unit]
Description=SO-101 policy inference server (ZMQ :5557) for eval_real.py --remote
After=network-online.target

[Service]
User=kurat
WorkingDirectory=/home/kurat/so101
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
# Pin CPU/GPU clocks at max ('+' runs it as root): inference is launch-bound, lazy DVFS cost ~15 ms/query.
ExecStartPre=+/usr/bin/jetson_clocks
ExecStart=/home/kurat/so101/venv/bin/python -u /home/kurat/so101/policy_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
