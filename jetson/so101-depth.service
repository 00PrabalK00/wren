[Unit]
Description=SO-101 RealSense aligned depth publisher (ZMQ :5556)
After=so101-scene-rgb.service

[Service]
User=kurat
WorkingDirectory=/home/kurat/so101
# numpy's BLAS threads spin on the small per-frame matrix multiply and eat every core; one thread is faster.
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -u /home/kurat/so101/depth_publisher.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
